{
  "expo": {
    "name": "Project Manager",
    "slug": "Project-Manager",
    "scheme": "projectmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/project_manager_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/project_manager_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/project_manager_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.dp.projectmanager",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "projectmanager-universallink.onrender.com",
              "pathPrefix": "/open-project-manager"
            },
            {
              "scheme": "http",
              "host": "projectmanager-universallink.onrender.com",
              "pathPrefix": "/open-project-manager"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["@react-native-community/datetimepicker"]
  }
}
